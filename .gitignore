# ==========================================
# Python / Backend
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
venv/
env/
.venv/
ENV/

# Environment Variables (Secrets)
.env
.env.local
.env.development.local

# SQLite Database (Local only)
*.db
*.sqlite3
marketplace.db

# ==========================================
# React / Frontend (Node.js)
# ==========================================
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# IDE & Editor Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ==========================================
# Logs & OS Files
# ==========================================
*.log
Thumbs.db
